gateway:
    host: 0.0.0.0
    port: 18790
    heartbeat:
        enabled: true
        interval_s: 1800
tools:
    web:
        search:
            api_key: ""
            max_results: 5
    exec:
        timeout: 60
    restrict_to_workspace: false
    mcp_servers:
        remote-exec:
            url: ""
        pairat-remote-exec:
            url: ""
        chrome-devtools:
            command: "npx"
            args: ["chrome-devtools-mcp@latest", "--autoConnect"]
